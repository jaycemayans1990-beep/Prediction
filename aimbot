-- 5. Dynamic Weapon Stats Engine
local function updateWeaponStats()
    if not State.AutoBulletSpeed then
        cachedBulletSpeed = math.max(State.BulletSpeed or 10000, 1)
        cachedBulletGravity = State.BulletGravity or 0
        return
    end

    local char = LocalPlayer and LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")

    if tool then
        local toolName = tool.Name:lower()
        local isLauncher = toolName:find("rpg") or toolName:find("rocket") or toolName:find("launcher") or toolName:find("grenade") or toolName:find("bazooka")

        local acsSettings = tool:FindFirstChild("ACS_Settings") or tool:FindFirstChild("Settings") or tool:FindFirstChild("Config")
        if acsSettings and acsSettings:IsA("ModuleScript") then
            local success, config = pcall(require, acsSettings)
            if success and type(config) == "table" then
                local speed = config.Velo or config.MuzzleVelocity or config.BulletSpeed or config.Velocity
                if type(speed) == "number" and speed > 0 then
                    cachedBulletSpeed = speed
                else
                    cachedBulletSpeed = State.BulletSpeed or 10000
                end

                local drop = config.Drop or config.BulletDrop or config.Gravity
                cachedBulletGravity = isLauncher and 0 or (type(drop) == "number" and drop or 0)
                return
            end
        end
    end

    cachedBulletSpeed = math.max(State.BulletSpeed or 3000, 1)
    cachedBulletGravity = State.BulletGravity or 0
end

local function setupCharacterSpeedListener(char)
    if not char then return end
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then task.defer(updateWeaponStats) end
    end)
    char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then task.defer(updateWeaponStats) end
    end)
    updateWeaponStats()
end

if LocalPlayer then
    if LocalPlayer.Character then setupCharacterSpeedListener(LocalPlayer.Character) end
    getgenv().SnyX_CharAddedConn = LocalPlayer.CharacterAdded:Connect(setupCharacterSpeedListener)
end

