-- 7. Target Validation Check
local function isValidEnemy(player)
    if not player or player == LocalPlayer or not player.Character then return false end
    
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")  
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")  
      
    if not humanoid or not rootPart or humanoid.Health <= 0 then   
        return false   
    end  
    
    if player.Character:FindFirstChildOfClass("ForceField") then  
        return false  
    end  
    
    if State.TeamCheck then  
        if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then  
            return false  
        end  
    end  
    
    return true
end

-- 8. Wall Check Function
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

-- สำหรับ Aimbot (ควบคุมผ่าน State.WallCheck)
local function isVisible(targetPart)
    if not State.WallCheck then return true end
    if not targetPart or not targetPart.Parent then return false end
    
    local camera = getCamera()
    if not camera then return false end

    local origin = camera.CFrame.Position  
    local destination = targetPart.Position  
    local direction = destination - origin  
      
    local filterList = {}
    if LocalPlayer.Character then
        table.insert(filterList, LocalPlayer.Character)
    end
    raycastParams.FilterDescendantsInstances = filterList

    local result = Workspace:Raycast(origin, direction, raycastParams)  
      
    if result then  
        return result.Instance:IsDescendantOf(targetPart.Parent)  
    end  
      
    return true
end

-- สำหรับ ESP (ยิง Raycast ทะลุวัตถุล่องหน เพื่อเช็คกำแพงทึบจริงๆ แก้ปัญหาสีเขียวค้างหลังตึก)
local function isEnemyVisible(targetCharacter)
    if not targetCharacter then return false end

    local camera = getCamera()
    if not camera then return false end

    local targetPart = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
    if not targetPart then return false end

    local origin = camera.CFrame.Position
    local targetPos = targetPart.Position
    local direction = targetPos - origin

    local raycastParamsESP = RaycastParams.new()
    raycastParamsESP.FilterType = Enum.RaycastFilterType.Exclude
    raycastParamsESP.IgnoreWater = true

    local filterList = {}
    if LocalPlayer.Character then
        table.insert(filterList, LocalPlayer.Character)
    end
    raycastParamsESP.FilterDescendantsInstances = filterList

    local currentOrigin = origin
    local currentDirection = direction

    -- ลูปยิงทะลุวัตถุโปร่งแสง/เอฟเฟกต์กล้องปืน/พาร์ทล่องหน สูงสุด 5 ชั้น
    for i = 1, 5 do
        local result = Workspace:Raycast(currentOrigin, currentDirection, raycastParamsESP)
        
        -- ถ้าลำแสงยิงทะลุไปจนถึงตัวศัตรูโดยไม่โดนอะไรทึบบัง = มองเห็น (สีเขียว)
        if not result then
            return true
        end

        local hitPart = result.Instance

        -- 1. ชนชิ้นส่วนตัวศัตรูโดยตรง = มองเห็น (สีเขียว)
        if hitPart:IsDescendantOf(targetCharacter) then
            return true
        end

        -- 2. ถ้าชนวัตถุล่องหน (Transparency > 0.8) หรือของตกแต่งที่ไม่มีแรงชน (CanCollide = false)
        -- ให้ใส่พาร์ทนั้นลงใน Filter แล้วยิงทะลุไปเช็คกำแพงข้างหลังต่อ
        if hitPart.Transparency > 0.8 or not hitPart.CanCollide then
            table.insert(filterList, hitPart)
            raycastParamsESP.FilterDescendantsInstances = filterList
            currentDirection = targetPos - result.Position
            currentOrigin = result.Position + (currentDirection.Unit * 0.05)
        else
            -- 3. ชนตึก กำแพงทึบ หรือสิ่งก่อสร้างจริง = มีสิ่งกีดขวางบังอยู่ (สีแดง)
            return false
        end
    end

    return false
end

-- 9. Target Acquisition
local function getClosestTarget()
    local closestPlayer = nil
    local shortestDist = State.FOV
    local camera = getCamera()
    if not camera then return nil end

    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do  
        if isValidEnemy(player) then  
            local targetPart = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")  
            if targetPart and isVisible(targetPart) then  
                local screenPoint, onScreen = camera:WorldToViewportPoint(targetPart.Position)  
                  
                if onScreen then  
                    local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                    local effectiveDist = (player == currentTarget) and (dist * 0.85) or dist
                    
                    if effectiveDist < shortestDist then  
                        shortestDist = effectiveDist  
                        closestPlayer = player  
                    end  
                end  
            end  
        end  
    end  
    return closestPlayer
end

-- 10. Advanced Dynamic Prediction Engine
local function getPredictedPosition(target)
    -- 1. เช็คว่า target และ Character มีอยู่จริง
    if not target or not target.Character then return nil end
    
    -- 2. หาชิ้นส่วนเป้าหมาย (ลำดับความสำคัญ: Head -> HumanoidRootPart)
    local targetPart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")  
    if not targetPart then return nil end  
      
    local targetPos = targetPart.Position  
    
    if State.Prediction then  
        local rootPart = target.Character:FindFirstChild("HumanoidRootPart")  
        if rootPart then  
            local camera = getCamera()
            -- [FIX]: ป้องกัน Error กรณีกล้องยังโหลดไม่เสร็จหรือไม่พบกล้อง
            if not camera then return targetPos end 
            
            local distance = (targetPos - camera.CFrame.Position).Magnitude
            
            -- [FIX]: ตรวจสอบให้แน่ใจว่า Ping อยู่ในหน่วย "วินาที" (ถ้า getPing คืนค่าเป็น ms ให้หาร 1000)
            -- สมมติว่า getPing() คืนค่าเป็น ms (เช่น 100) -> 100 / 1000 = 0.1 วินาที
            local rawPing = getPing()
            local currentPing = (rawPing > 10) and (rawPing / 1000) or rawPing 
            
            local speed = State.AutoBulletSpeed and cachedBulletSpeed or State.BulletSpeed
            local gravity = State.AutoBulletSpeed and cachedBulletGravity or State.BulletGravity
            
            -- คำนวณเวลาที่กระสุนจะเดินทางไปถึง (ระยะทาง / ความเร็ว) + เวลาหน่วงจากปิง
            -- math.max(speed, 1) ช่วยป้องกัน Error การหารด้วย 0 ได้ดีมาก
            local timeToTarget = (distance / math.max(speed, 1)) + currentPing
            
            local velocity = rootPart.AssemblyLinearVelocity  
            
            -- [IMPROVEMENT]: ตรวจสอบการเคลื่อนที่ เพื่อชดเชยตำแหน่ง (Prediction)
            if velocity.Magnitude > 0.5 then
                targetPos = targetPos + (velocity * timeToTarget)
            end

            -- [CHECK]: ชดเชยวิถีกระสุนตก (Bullet Drop)
            -- สูตร 0.5 * g * t^2 ถูกต้องแล้ว (เมื่อเป้าหมายบวกค่า Y เพิ่ม = เล็งเผื่อสูงขึ้น)
            if gravity > 0 then
                local dropOffset = Vector3.new(0, 0.5 * gravity * (timeToTarget ^ 2), 0)
                targetPos = targetPos + dropOffset
            end
        end  
    end  
      
    return targetPos
end

-- 11. ESP Management
local COLOR_VISIBLE_FILL = Color3.fromRGB(0, 255, 128)     -- ตัวสีเขียว (เห็นตัว / ยิงผ่านได้)
local COLOR_VISIBLE_OUTLINE = Color3.fromRGB(255, 215, 0)  -- ขอบสีทอง (Gold)

local COLOR_OBSTRUCTED_FILL = Color3.fromRGB(255, 50, 50)  -- ตัวสีแดง (มีกำแพงทึบบังอยู่)
local COLOR_OBSTRUCTED_OUTLINE = Color3.fromRGB(100, 0, 0) -- ขอบสีแดงเข้ม

local function clearESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local highlight = player.Character:FindFirstChild("ESP_Highlight")
            if highlight then highlight:Destroy() end
            local nameTag = player.Character:FindFirstChild("ESP_NameTag")
            if nameTag then nameTag:Destroy() end
        end
    end
end

local function processESP()
    if not State.ESP and not State.ESPName then
        clearESP()
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do  
        if player ~= LocalPlayer and player.Character then
            local isEnemy = isValidEnemy(player)
            local char = player.Character
            local head = char:FindFirstChild("Head")

            -- ดึงค่าการมองเห็นจากฟังก์ชัน isEnemyVisible ใน Section 8
            local visible = isEnemyVisible(char)

            -- ===== 1. ESP Highlight =====
            local highlight = char:FindFirstChild("ESP_Highlight")
            if State.ESP and isEnemy then
                if not highlight then  
                    highlight = Instance.new("Highlight")  
                    highlight.Name = "ESP_Highlight"  
                    highlight.FillTransparency = 0.25
                    highlight.OutlineTransparency = 0
                    highlight.Parent = char
                end  
                
                -- สลับสีตัวและสีขอบตามสถานะ (เห็น = ตัวเขียว ขอบทอง | บัง = ตัวแดง ขอบแดงเข้ม)
                highlight.FillColor = visible and COLOR_VISIBLE_FILL or COLOR_OBSTRUCTED_FILL
                highlight.OutlineColor = visible and COLOR_VISIBLE_OUTLINE or COLOR_OBSTRUCTED_OUTLINE
            elseif highlight then
                highlight:Destroy()
            end

            -- ===== 2. ESP NameTag =====
            local nameTag = char:FindFirstChild("ESP_NameTag")
            if State.ESPName and isEnemy and head then
                if not nameTag then
                    nameTag = Instance.new("BillboardGui")
                    nameTag.Name = "ESP_NameTag"
                    nameTag.Adornee = head
                    nameTag.Size = UDim2.new(0, 150, 0, 30)
                    nameTag.StudsOffset = Vector3.new(0, 2, 0)
                    nameTag.AlwaysOnTop = true
                    nameTag.Parent = char

                    local textLabel = Instance.new("TextLabel")
                    textLabel.Name = "TagLabel"
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.Text = player.Name
                    textLabel.TextStrokeTransparency = 0
                    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    textLabel.Font = Enum.Font.SourceSansBold
                    textLabel.TextSize = 14
                    textLabel.Parent = nameTag
                end

                -- อัปเดตสีตัวอักษรชื่อตามสถานะการมองเห็น
                local textLabel = nameTag:FindFirstChild("TagLabel")
                if textLabel then
                    textLabel.TextColor3 = visible and COLOR_VISIBLE_FILL or COLOR_OBSTRUCTED_FILL
                end
            elseif nameTag then
                nameTag:Destroy()
            end
        end
    end
end

