-- 3. Ping Helper Function
local function getPing()
    if LocalPlayer then
        local success, ping = pcall(function()
            return LocalPlayer:GetNetworkPing()
        end)
        if success and type(ping) == "number" then
            return ping / 2 -- One-way latency
        end
    end
    return 0.025
end

